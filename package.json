{
  "name": "mirlume",
  "version": "0.5.11",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run assets:prepare && npm run build && electron-builder --win --publish never",
    "android:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios",
    "assets:prepare": "node scripts/generate-assets.mjs",
    "assets:android": "npm run assets:prepare && npx @capacitor/assets generate --android",
    "assets:ios": "npm run assets:prepare && npx @capacitor/assets generate --ios",
    "native:android": "npx cap sync android && node scripts/install-android-writer.mjs",
    "native:ios": "npx cap sync ios && node scripts/install-ios-writer.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tus-js-client": "^4.3.1",
    "electron-updater": "^6.6.2",
    "@capacitor/browser": "^7.0.0",
    "@capacitor-community/safe-area": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.5",
    "@capacitor/assets": "^3.0.5",
    "sharp": "^0.34.4"
  },
  "build": {
    "appId": "io.mirlume.chat",
    "productName": "Mirlume",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Mirlume",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DakotaPlayz",
        "repo": "Discordesque",
        "releaseType": "release"
      }
    ]
  },
  "description": "Mirlume private chat, file sharing and voice calling",
  "author": "DakotaPlayz",
  "repository": "https://github.com/DakotaPlayz/Discordesque"
}
